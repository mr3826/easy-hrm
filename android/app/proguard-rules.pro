# Suppress warnings for Pushy library
-dontwarn me.pushy.**

# Keep all classes in the Pushy library
-keep class me.pushy.** { *; }

# Keep all classes in androidx.core.app package
-keep class androidx.core.app.** { *; }

# Keep all classes in android.support.v4.app package
-keep class android.support.v4.app.** { *; }
